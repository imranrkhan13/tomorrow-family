{
  "name": "tomorrow-family",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node --import tsx server/dev.ts",
    "build": "tsc --noEmit && vite build",
    "test": "node --import tsx --test tests/*.test.ts",
    "verify": "npm test && npm run build",
    "start": "node --import tsx server/dev.ts",
    "test:runtime": "tsc --noEmit false --outDir .private/compiled --module NodeNext --moduleResolution NodeNext && node --test .private/compiled/tests/*.test.js"
  },
  "dependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "vite": "^6.4.0"
  }
}
